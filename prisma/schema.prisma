// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


/// Inbound lead captured from the contact form / service-detail inline form.
/// One row per submission. status tracks the lifecycle of the lead.
/// Sensitive fields (name, phone, email, message) are AES-256-GCM encrypted.
model Lead {
  id            String   @id @default(cuid())
  
  // Encrypted PII fields (stored as base64-encoded ciphertext)
  nameEnc       String   // Encrypted full name
  phoneEnc      String   // Encrypted phone number
  emailEnc      String?  // Encrypted email address (optional)
  messageEnc    String?  // Encrypted customer message (optional)
  
  // Non-sensitive fields (searchable, filterable)
  city          String
  service       String
  propertyType  String   @default("Residential")
  preferredDate String?
  source        String   @default("contact-form") // contact-form | service-detail | inline-quote
  status        String   @default("new") // new | contacted | quoted | won | lost | whatsapp_sent
  
  // WhatsApp integration fields (for future use)
  whatsappSent  Boolean  @default(false)     // Whether WhatsApp notification was sent
  whatsappSid   String?  // WhatsApp message SID after sending
  
  // Metadata
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastContactedAt DateTime?
  notes         String?  // Internal notes for the sales team

  @@index([status, createdAt])
  @@index([city])
  @@index([service])
  @@index([source])
}